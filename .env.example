# ===== Copiar este archivo como ".env" y completar con valores propios =====

# --- Django ---
DEBUG=False
SECRET_KEY='generar-una-clave-propia-ver-README'
ALLOWED_HOSTS=sigrams.ejemplo.gob.ar
CSRF_TRUSTED_ORIGINS=https://sigrams.ejemplo.gob.ar

# --- Base de datos (PostgreSQL con PostGIS) ---
DATABASE_NAME=sigrams_db
DATABASE_USER=sigrams_user
DATABASE_PASSWORD='clave-de-la-base'
DATABASE_HOST=localhost
DATABASE_PORT=5432

# --- Correo (SMTP del Ministerio o servicio transaccional) ---
EMAIL_HOST=smtp.ejemplo.gob.ar
EMAIL_PORT=587
EMAIL_HOST_USER='usuario-smtp'
EMAIL_HOST_PASSWORD='clave-smtp'
DEFAULT_FROM_EMAIL='SIGRAMS <no-reply@ejemplo.gob.ar>'

# --- reCAPTCHA v2 (casilla "No soy un robot"), claves del dominio real ---
RECAPTCHA_PUBLIC_KEY='clave-del-sitio'
RECAPTCHA_PRIVATE_KEY='clave-secreta'

# --- Seguridad HTTPS (solo se aplican con DEBUG=False) ---
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=3600
BEHIND_PROXY=True